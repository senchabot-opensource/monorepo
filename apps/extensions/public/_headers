# Workers static assets default to "max-age=0, must-revalidate"; a matching rule replaces it.
/robots.txt
  Cache-Control: public, max-age=86400

/sitemap.xml
  Cache-Control: public, max-age=86400

/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=86400

/llms-full.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=86400

/manifest.json
  Cache-Control: public, max-age=86400

/senchabot-logo.svg
  Cache-Control: public, max-age=86400

/favicon.ico
  Cache-Control: public, max-age=604800
